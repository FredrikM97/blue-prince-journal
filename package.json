{
  "name": "blue-prince-journal",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:bundled": "sh -c 'trap \"kill 0\" EXIT; vite build --mode development --watch & vite preview --strictPort --port 8080'",
    "dev:prod": "npm run build && wrangler pages dev dist --compatibility-date=2026-06-05",
    "build": "vite build && node scripts/generate-redirects.mjs && node scripts/stamp-sitemap.mjs && cp dist/index.html dist/404.html",
    "build:dev": "vite build --mode development",
    "test": "npm run check:types && npm run test:vitest",
    "test:vitest": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:integration:ui": "vitest run tests/integration/ui",
    "test:smoke:ui": "vitest run tests/integration/smoke-ui",
    "test:e2e": "playwright test",
    "test:smoke:local": "playwright test tests/e2e",
    "test:e2e:headed": "xvfb-run --auto-servernum playwright test --headed",
    "test:e2e:headed:native": "playwright test --headed",
    "test:verify:local": "npm run test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "audit:ui-oddities": "rg -n --glob 'src/components/**/*.{ts,tsx}' 'className=\\\"[^\\\"]*(flex items-center gap-2|flex flex-wrap justify-center gap-3|w-full max-w-6xl space-y-8 text-center|border-t border-border/70 pt-6|space-y-1)\\\"'",
    "format": "prettier --write .",
    "check:types": "tsc --noEmit",
    "check:unused": "knip",
    "deploy": "npm run build && wrangler pages deploy dist --project-name blue-prince-journal",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.40",
    "clsx": "^2.1.1",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "idb": "^8.0.3",
    "jszip": "^3.10.2",
    "lucide-react": "^0.575.0",
    "nanoid": "^5.1.16",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "vite-tsconfig-paths": "^6.0.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.61.0",
    "@cloudflare/workers-types": "^4.20260602.1",
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^27.2.0",
    "knip": "^6.38.0",
    "prettier": "^3.9.9",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^4.0.8",
    "wrangler": "^4.142.0"
  }
}
